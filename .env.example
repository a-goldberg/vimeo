# Copy this file to .env and fill in the values.
# Never commit .env to GitHub.

PORT=3000
NODE_ENV=development
FIRST_NAME=Your
LAST_NAME=Name

# Default Vimeo personal access token used for anonymous GET/HEAD demo requests.
# Treat every Vimeo response readable by this token as public site data.
# Mutating Vimeo requests still require a connected OAuth session.
# Generate at https://developer.vimeo.com/apps under "Authentication".
VIMEO_TOKEN=

# Not currently read anywhere in the code (confirmed by grep) — reserved for a
# possible future admin-secret-gated action. Safe to leave blank.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# Session secret — required; must be a long random string.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Vimeo OAuth app credentials — required for per-user OAuth.
# Create an app at https://developer.vimeo.com/apps and add a redirect URI there.
VIMEO_CLIENT_ID=
VIMEO_CLIENT_SECRET=
# Must match exactly what you registered in the Vimeo app settings:
#   Local dev:  http://localhost:3000/auth/vimeo/callback
#   Production: https://yourdomain.com/auth/vimeo/callback
VIMEO_REDIRECT_URI=
# Space-separated scopes. "public private" covers most read/write operations.
VIMEO_SCOPES=public private

# Webinar event ID for the webinar registration tool.
VIMEO_EVENT_ID=
