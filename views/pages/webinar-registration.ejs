<div class="page page--webinar-registration">
  <div class="container">
    <!-- Page header -->
    <div class="page-hero">
      <p class="hero__overline">Customer Projects</p>
      <h1 class="page-hero__heading">Webinar Registration</h1>
      <p class="page-hero__desc">
        Register attendees for a Vimeo-powered webinar. Enter your event
        credentials below, or leave them blank to use the server defaults from
        <code>.env</code>.
      </p>
    </div>

    <!-- API / event config -->
    <div class="card">
      <form id="configForm" novalidate>
        <div class="field-group">
          <label class="field-label" for="tokenInput"
            >Personal Access Token
            <span class="field-optional"
              >(optional — overrides server default)</span
            ></label
          >
          <input
            type="text"
            id="tokenInput"
            class="field-input"
            placeholder="Your Token must have the CAPABILITY_ACCESS_LEADS capability."
            autocomplete="off"
            spellcheck="false" />
        </div>
        <div class="field-group">
          <label class="field-label" for="eventIdInput"
            >Webinar Event ID
            <span class="field-optional"
              >(optional — overrides server default)</span
            ></label
          >
          <input
            type="text"
            id="eventIdInput"
            class="field-input"
            placeholder="Your Event must be scheduled and accepting registrations."
            autocomplete="off"
            spellcheck="false" />
        </div>
        <p id="configError" class="field-error hidden"></p>
        <p id="configStatus" class="field-hint hidden"></p>
        <button type="submit" class="btn btn--primary right">
          Apply Config
        </button>
      </form>
    </div>

    <!-- Attendee registration form -->
    <div class="card">
      <form id="regForm" novalidate>
        <div class="field-group">
          <label class="field-label" for="firstNameInput">First Name</label>
          <input
            type="text"
            id="firstNameInput"
            class="field-input"
            placeholder="Jane"
            autocomplete="given-name" />
        </div>
        <div class="field-group">
          <label class="field-label" for="lastNameInput">Last Name</label>
          <input
            type="text"
            id="lastNameInput"
            class="field-input"
            placeholder="Smith"
            autocomplete="family-name" />
        </div>
        <div class="field-group">
          <label class="field-label" for="emailInput">Email Address</label>
          <input
            type="email"
            id="emailInput"
            class="field-input"
            placeholder="jane@example.com"
            autocomplete="email" />
        </div>
        <p id="regError" class="field-error hidden"></p>
        <button type="submit" id="registerBtn" class="btn btn--primary right">
          Register
        </button>
      </form>

      <!-- Shown after successful registration -->
      <div id="regConfirmed" class="wr-status-block hidden">
        <p class="wr-status-icon wr-status-icon--success">✓</p>
        <p class="wr-status-heading">You're Registered!</p>
        <p class="wr-status-body">
          You will receive a reminder email 24 hours before the webinar starts.
          See you there!
        </p>
      </div>

      <!-- Shown when duplicate email detected -->
      <div id="alreadyReg" class="wr-status-block hidden">
        <p class="wr-status-icon wr-status-icon--info">i</p>
        <p class="wr-status-heading">Already Registered</p>
        <p class="wr-status-body">
          This email address is already signed up for this event.
        </p>
      </div>
    </div>
  </div>
  <!-- /.container -->
</div>
<!-- /.page -->

<!-- Toast container lives outside the main flow so it can be fixed-position -->
<div
  id="toastContainer"
  class="toast-container"
  role="status"
  aria-live="polite"></div>
