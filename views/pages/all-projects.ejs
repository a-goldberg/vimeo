<div class="page page--index">

  <div class="page-hero container">
    <p class="hero__overline">All</p>
    <h1 class="page-hero__heading">All Projects</h1>
    <p class="page-hero__desc"></p>
  </div>

  <div class="container">

    <div class="filter-bar">
      <input
        type="search"
        class="filter-bar__input"
        placeholder="Filter projects… (coming soon)"
        disabled
        aria-label="Filter projects"
      />
      <div class="filter-bar__tags">
        <span class="tag tag--active">All</span>
        <span class="tag">Demo</span>
        <span class="tag">Portal</span>
        <span class="tag">Internal</span>
        <span class="tag">Customer</span>
      </div>
    </div>

    <% if (projects.length > 0) { %>
      <div class="card-grid">
        <% projects.forEach(function(project) { %>
          <%- include('../partials/project-card', { project }) %>
        <% }); %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <span class="empty-state__icon">◈</span>
        <h3 class="empty-state__heading">No projects yet</h3>
        <p class="empty-state__desc">Add projects to <code>src/data/projects.js</code>.</p>
      </div>
    <% } %>

  </div>
</div>
